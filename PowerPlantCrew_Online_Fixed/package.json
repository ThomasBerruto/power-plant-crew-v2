{
  "name": "power-plant-game",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "preview": "vite preview",
    "spacetime:generate": "spacetime generate",
    "spacetime:publish": "spacetime publish",
